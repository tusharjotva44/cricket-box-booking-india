rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /owners/{ownerId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.superAdmin == true);
      allow create: if request.auth != null && request.auth.uid == ownerId;
      allow update, delete: if request.auth != null && request.auth.token.superAdmin == true;
    }

    match /grounds/{groundId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}