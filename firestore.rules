rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.superAdmin == true
        && request.auth.token.email == 'tusharjotva44@gmail.com';
    }

    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSuperAdmin();
    }

    match /transactionHistory/{transactionId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Allows the authorized Super Admin to query all nested purchase requests.
    match /{path=**}/purchaseHistory/{historyId} {
      allow read: if isSuperAdmin();
    }

    match /owners/{ownerId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin());
      // Owner profiles are created only by the trusted createOwnerProfile function.
      allow create: if false;
      allow update: if request.auth != null
        && (
          isSuperAdmin()
          || (
            request.auth.uid == ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'updatedAt'])
          )
        );
      allow delete: if request.auth != null && isSuperAdmin();

      function isValidOwnerPlanRequest() {
        let planPath = /databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId);
        let ownerPath = /databases/$(database)/documents/owners/$(ownerId);
        let planExists = exists(planPath);
        let ownerExists = exists(ownerPath);
        let plan = planExists ? get(planPath).data : {};
        let owner = ownerExists ? get(ownerPath).data : {};
        let durationValue = plan.get('durationValue', 1);
        let durationUnit = plan.get('durationUnit', 'months');
        let groundLimit = plan.get('grounds', 1);
        let discount = plan.get('discount', 0);
        let expectedAmount = plan.get('price', 0) * (100 - discount) / 100;
        let snapshot = request.resource.data.planSnapshot;
        return request.auth != null
          && request.auth.uid == ownerId
          && planExists
          && ownerExists
          && request.resource.data.keys().hasOnly([
            'ownerUid','ownerEmail','ownerName','planId','planName','amount',
            'planSnapshot','source','status','createdAt'
          ])
          && request.resource.data.ownerUid == ownerId
          && request.resource.data.ownerEmail is string
          && request.resource.data.ownerEmail.size() <= 254
          && request.resource.data.ownerName == owner.get('fullName', 'Owner')
          && request.resource.data.planId is string
          && request.resource.data.planId.size() > 0
          && request.resource.data.planName == plan.get('name', '')
          && plan.get('active', true) != false
          && plan.get('kind', 'active') != 'trial'
          && plan.get('price', 0) is number
          && plan.get('price', 0) > 0
          && discount is number
          && discount >= 0
          && discount <= 100
          && durationValue is int
          && durationValue >= 1
          && durationValue <= 120
          && durationUnit in ['days', 'months', 'years']
          && groundLimit is int
          && groundLimit >= 1
          && groundLimit <= 100
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount >= expectedAmount - 0.01
          && request.resource.data.amount <= expectedAmount + 0.01
          && snapshot is map
          && snapshot.keys().hasAll(['name','durationValue','durationUnit','groundLimit','amount'])
          && snapshot.keys().hasOnly(['name','durationValue','durationUnit','groundLimit','amount'])
          && snapshot.name == plan.get('name', '')
          && snapshot.durationValue == durationValue
          && snapshot.durationUnit == durationUnit
          && snapshot.groundLimit == groundLimit
          && snapshot.amount == request.resource.data.amount
          && request.resource.data.source == 'Owner Dashboard'
          && request.resource.data.status == 'Pending'
          && request.resource.data.createdAt == request.time;
      }

      match /purchaseHistory/{historyId} {
        allow read: if request.auth != null
          && (request.auth.uid == ownerId || isSuperAdmin());
        // Owners may create only a validated pending request for an active paid plan.
        // Super Admin may still create its own manual activation history rows.
        allow create: if isValidOwnerPlanRequest()
          || (isSuperAdmin()
            && request.resource.data.ownerUid == ownerId
            && request.resource.data.ownerEmail is string
            && request.resource.data.planId is string
            && request.resource.data.planName is string
            && request.resource.data.amount is number
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','planId','planName','amount','source','status','createdAt'])
            && request.resource.data.source == 'Super Admin'
            && request.resource.data.status in ['Paid','Active']);
        allow update: if isSuperAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && resource.data.status == 'Pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','source','amount','txnId','reviewNote','reviewedAt','reviewedBy'
          ])
          && request.resource.data.status in ['Paid','Rejected']
          && request.resource.data.source == 'Super Admin';
        allow delete: if isSuperAdmin();
      }
    }

    match /grounds/{groundId} {
      allow read: if true;
      // Owner ground writes go through saveOwnerGrounds, which checks the
      // current subscription and ground limit before using the Admin SDK.
      allow create, update, delete: if isSuperAdmin();
    }

    match /bookingSlots/{slotId} {
      // Slot availability is public; only the server booking transaction can create locks.
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'holdExpiresAt', 'updatedAt'])
        && request.resource.data.status == 'Confirmed'
        && request.resource.data.holdExpiresAt == 0;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }

    match /ownerActivityLogs/{activityId} {
      allow read: if isSuperAdmin();
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerName is string
        && request.resource.data.activityType in ['Ground Added', 'Ground Edited', 'Ground Deleted']
        && request.resource.data.groundId is string
        && request.resource.data.groundName is string
        && request.resource.data.sport is string
        && request.resource.data.location is string
        && request.resource.data.actorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerEmail', 'ownerName',
          'actorUid', 'actorEmail', 'actorName',
          'activityType', 'groundId', 'groundName',
          'sport', 'location', 'createdAt'
        ])
        && (
          request.resource.data.ownerUid == request.auth.uid
          || isSuperAdmin()
        );
      allow update, delete: if false;
    }

    match /ownerNotifications/{ownerId}/items/{notificationId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin());
      allow create, delete: if false;
      allow update: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid
          || request.auth.uid == resource.data.customerUid
          || isSuperAdmin());

      // All creates are performed by the validated createBooking Cloud Function.
      allow create: if false;

      allow update: if (
          request.auth != null
          && (request.auth.uid == resource.data.ownerUid || isSuperAdmin())
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'updatedAt'])
          && request.resource.data.status in ['Confirmed', 'Rejected', 'Expired']
        )
        || (
          request.auth != null
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
          && request.resource.data.paymentStatus == 'Payment submitted — not verified'
          && resource.data.status in ['Pending', 'Confirmed']
        );

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }
  }
}