rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /owners/{ownerId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.superAdmin == true);
      allow create: if request.auth != null && request.auth.uid == ownerId;
      allow update: if request.auth != null
        && (
          request.auth.token.superAdmin == true
          || (
            request.auth.uid == ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'updatedAt'])
          )
        );
      allow delete: if request.auth != null && request.auth.token.superAdmin == true;
    }

    match /grounds/{groundId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /bookingSlots/{slotId} {
      allow read: if true;

      allow create: if request.resource.data.bookingId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.groundId is string
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.groundId == request.resource.data.groundId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotIds.hasAny([slotId]);

      allow update: if (
          request.auth != null
          && request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          resource.data.status == 'Pending'
          && resource.data.holdExpiresAt <= request.time.toMillis()
          && request.resource.data.bookingId is string
          && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerUid == request.resource.data.ownerUid
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.groundId == request.resource.data.groundId
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotIds.hasAny([slotId])
        );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.ownerUid
          || request.auth.token.superAdmin == true
        );

      allow create: if request.resource.data.ownerUid is string
        && request.resource.data.groundId is string
        && exists(/databases/$(database)/documents/grounds/$(request.resource.data.groundId))
        && get(/databases/$(database)/documents/grounds/$(request.resource.data.groundId)).data.ownerUid == request.resource.data.ownerUid
        && request.resource.data.id == bookingId
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.amount is number
        && (
          (
            request.resource.data.status == 'Pending'
            && request.resource.data.bookingSource == 'Main website'
          )
          ||
          (
            request.auth != null
            && request.auth.uid == request.resource.data.ownerUid
            && request.resource.data.bookingSource == 'Owner dashboard'
            && request.resource.data.status in ['Pending', 'Confirmed', 'Rejected', 'Expired', 'Cancelled']
          )
        );

      allow update: if (
          request.auth != null
          && request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'updatedAt'])
          && request.resource.data.status in ['Confirmed', 'Rejected', 'Expired']
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
          && request.resource.data.paymentStatus == 'Payment submitted — not verified'
          && resource.data.status == 'Pending'
        );

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || request.auth.token.superAdmin == true);
    }
  }
}