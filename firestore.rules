rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.superAdmin == true
        && request.auth.token.email == 'tusharjotva44@gmail.com';
    }

    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSuperAdmin();
    }

    match /transactionHistory/{transactionId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /owners/{ownerId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isSuperAdmin());
      allow create: if request.auth != null && request.auth.uid == ownerId;
      allow update: if request.auth != null
        && (
          isSuperAdmin()
          || (
            request.auth.uid == ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'updatedAt'])
          )
        );
      allow delete: if request.auth != null && isSuperAdmin();

      match /purchaseHistory/{historyId} {
        allow read: if request.auth != null
          && (request.auth.uid == ownerId || isSuperAdmin());
        allow create: if request.auth != null
          && request.resource.data.ownerUid == ownerId
          && request.resource.data.ownerEmail is string
          && request.resource.data.planId is string
          && request.resource.data.planName is string
          && request.resource.data.amount is number
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','planId','planName','amount','source','status','createdAt'])
          && (
            (
              request.auth.uid == ownerId
              && request.resource.data.source == 'Owner Dashboard'
              && request.resource.data.status == 'Pending'
            )
            || (
              isSuperAdmin()
              && request.resource.data.source in ['Super Admin','Payment Gateway']
              && request.resource.data.status in ['Paid','Active']
            )
          );
        allow update: if isSuperAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','source','updatedAt'])
          && request.resource.data.status in ['Pending','Paid','Rejected'];
        allow delete: if isSuperAdmin();
      }
    }

    match /grounds/{groundId} {
      allow read: if true;
      allow create: if request.auth != null
        && (
          request.resource.data.ownerUid == request.auth.uid
          || isSuperAdmin()
        );
      allow update: if request.auth != null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          resource.data.ownerUid == request.auth.uid
          || isSuperAdmin()
        );
      allow delete: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || isSuperAdmin()
        );
    }

    match /bookingSlots/{slotId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.bookingId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.groundId is string
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.groundId == request.resource.data.groundId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotIds.hasAny([slotId])
        && (
          request.auth.token.email == 'niklo12@gmail.com'
          && request.auth.token.firebase.sign_in_provider == 'password'
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.auth.uid
        );

      allow update: if (
          request.auth != null
          && (request.auth.uid == resource.data.ownerUid || isSuperAdmin())
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          request.auth != null
          && request.auth.token.email == 'niklo12@gmail.com'
          && request.auth.token.firebase.sign_in_provider == 'password'
          && resource.data.status == 'Pending'
          && resource.data.holdExpiresAt <= request.time.toMillis()
          && request.resource.data.bookingId is string
          && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerUid == request.resource.data.ownerUid
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.groundId == request.resource.data.groundId
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotIds.hasAny([slotId])
          && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid == request.auth.uid
        );

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.ownerUid
          || isSuperAdmin()
        );

      allow create: if request.auth != null
        && request.auth.token.email == 'niklo12@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.bookingSource == 'Main website'
        && request.resource.data.status == 'Pending'
        && request.resource.data.ownerUid is string
        && request.resource.data.groundId is string
        && exists(/databases/$(database)/documents/grounds/$(request.resource.data.groundId))
        && get(/databases/$(database)/documents/grounds/$(request.resource.data.groundId)).data.ownerUid == request.resource.data.ownerUid
        && request.resource.data.id == bookingId
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.amount is number;

      allow update: if (
          request.auth != null
          && (request.auth.uid == resource.data.ownerUid || isSuperAdmin())
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'updatedAt'])
          && request.resource.data.status in ['Confirmed', 'Rejected', 'Expired']
        )
        || (
          request.auth != null
          && request.auth.token.email == 'niklo12@gmail.com'
          && request.auth.token.firebase.sign_in_provider == 'password'
          && resource.data.customerUid == request.auth.uid
          && resource.data.bookingSource == 'Main website'
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
          && request.resource.data.paymentStatus == 'Payment submitted — not verified'
          && resource.data.status in ['Pending', 'Confirmed']
        );

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }
  }
}